{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subboost-local",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "cloudflare/worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subboost-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "YAML_QUEUE", "queue": "subboost-local-jobs" }
    ],
    "consumers": [
      { "queue": "subboost-local-jobs", "max_batch_size": 1 }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
